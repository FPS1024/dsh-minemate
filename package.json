{
  "name": "@fps1024/dsh-minemate",
  "version": "1.2.2",
  "description": "DSH-powered Minecraft Java companion: a real player body driven by a DeepSeek Harness Agent.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "pretest": "bash scripts/link-harness-peers.sh",
    "check": "node --check index.js && node --check client.js && node --check lib/perception.js && node --check lib/bot.js && node --check lib/humanizer.js && node --check lib/tools.js && node --check lib/companion.js && node --check lib/persona.js",
    "test": "pnpm run check && node --test test/*.test.mjs",
    "smoke": "node test/vertical-slice.mjs",
    "smoke:place": "node test/place-slice.mjs",
    "smoke:container": "node test/container-slice.mjs",
    "smoke:sleep": "node test/sleep-slice.mjs",
    "smoke:defend": "node test/defend-slice.mjs",
    "smoke:lava": "node test/lava-slice.mjs",
    "smoke:connect": "node test/quick-connect.mjs",
    "smoke:actions": "node test/quick-actions.mjs",
    "smoke:owner": "node test/quick-owner.mjs",
    "market": "node scripts/generate-market-index.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "vec3": "^0.2.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.7"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "ai-agent"
  ],
  "author": "FPS1024",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FPS1024/dsh-minemate.git"
  },
  "homepage": "https://github.com/FPS1024/dsh-minemate#readme",
  "bugs": {
    "url": "https://github.com/FPS1024/dsh-minemate/issues"
  }
}
